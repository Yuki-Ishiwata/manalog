# Copy to deploy.config.local and set the ManaLog-specific destination.
# DEPLOY_ROOT is a private directory outside public_html.
# DEPLOY_PUBLIC_ROOT is the subdomain document root selected in Xserver.
DEPLOY_SSH_HOST=""
DEPLOY_SSH_USER=""
DEPLOY_SSH_PORT="10022"
DEPLOY_SSH_KEY="$HOME/.ssh/xserver_deploy_key"
DEPLOY_ROOT=""
DEPLOY_PUBLIC_ROOT=""
